# Připojení k PostgreSQL. Na Renderu se doplní samo z databáze v render.yaml.
DATABASE_URL=postgres://odevy:odevy@127.0.0.1:5432/odevy

# Heslo do přehledu výsledků. Na Renderu ho zadejte v Dashboardu (sync: false).
ADMIN_PASSWORD=zmente-toto-heslo

# Tajemství pro přihlašovací cookie. Na Renderu se vygeneruje samo.
SESSION_SECRET=nahodny-dlouhy-retezec
